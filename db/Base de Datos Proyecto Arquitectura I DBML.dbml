Table Rol [headercolor: #175e7a] {
	id_rol integer [ pk, increment, not null ]
	nombre varchar(50) [ not null ]
}

Table Usuario [headercolor: #175e7a] {
	id_usuario integer [ pk, increment, not null ]
	id_rol integer [ not null ]
	usuario varchar(100) [ not null, unique ]
	password varchar(255) [ not null ]
	nombre varchar(100) [ not null ]
	apellido varchar(100) [ not null ]
	telefono varchar(255)
	direccion varchar(255)
}

Table Cliente [headercolor: #175e7a] {
	id_cliente integer [ pk, increment, not null ]
	id_tipoCliente integer
	id_usuario integer [ not null ]
	nit varchar(20)
	id_tipoCliente integer [ not null ]
}

Table TipoCliente [headercolor: #175e7a] {
	id_tipoCliente integer [ pk, increment, not null ]
	tipo varchar(50) [ not null ]
	descuento decimal(10,2) [ not null ]
}

Table Categoria [headercolor: #175e7a] {
	id_categoria integer [ pk, increment, not null ]
	nombre varchar(100) [ not null ]
	estado bit [ not null ]
}

Table Autor [headercolor: #175e7a] {
	id_autor integer [ pk, increment, not null ]
	nombre varchar(100) [ not null ]
	nacionalidad varchar(100)
}

Table Editorial [headercolor: #175e7a] {
	id_editorial integer [ pk, increment, not null ]
	nombre varchar(150) [ not null ]
	telefono varchar(20)
	correo varchar(150)
	direccion varchar(255)
}

Table Formato [headercolor: #175e7a] {
	id_formato integer [ pk, increment, not null ]
	tipo varchar(50) [ not null ]
}

Table Libro [headercolor: #175e7a] {
	id_libro integer [ pk, increment, not null ]
	id_categoria integer [ not null ]
	id_editorial integer [ not null ]
	id_formato integer [ not null ]
	id_autor integer
	nombre varchar(200) [ not null ]
	sinopsis varchar(3000)
	isbn varchar(50) [ not null, unique ]
	precio_base decimal(10,2) [ not null ]
	estado bit [ not null ]
}

Table Inventario [headercolor: #175e7a] {
	id_inventario integer [ pk, increment, not null ]
	id_libro integer [ not null ]
	stock integer [ not null ]
}

Table Orden [headercolor: #175e7a] {
	id_orden integer [ pk, increment, not null ]
	id_cotizacion integer [ not null ]
	id_usuario integer [ not null ]
	subtotal_base decimal(10,2) [ not null ]
	descuento_volumen decimal(10,2) [ not null ]
	descuento_cliente decimal(10,2) [ not null ]
	impuesto decimal(10,2) [ not null ]
	total_final decimal(10,2) [ not null ]
	estado varchar(50) [ not null ]
	fecha datetime [ not null ]
}

Table DetalleOrden [headercolor: #175e7a] {
	id_detalleOrden integer [ pk, increment, not null ]
	id_orden integer [ not null ]
	id_libro integer [ not null ]
	cantidad integer [ not null ]
	precio_unitario decimal(10,2) [ not null ]
	subtotal_item decimal(10,2) [ not null ]
}

Table Solicitud [headercolor: #175e7a] {
	id_solicitud integer [ pk, increment, not null ]
	id_cliente integer [ not null ]
	fecha_requerida_entrega date [ not null ]
	fecha_solicitud datetime [ not null ]
	estado varchar(50) [ not null ]
}

Table Cotizacion [headercolor: #175e7a] {
	id_cotizacion integer [ pk, increment, not null ]
	id_solicitud integer [ not null ]
	subtotal decimal(10,2) [ not null ]
	impuesto decimal(10,2) [ not null ]
	total decimal(10,2) [ not null ]
	estado varchar(50) [ not null ]
	fecha datetime [ not null ]
}

Table Imagen [headercolor: #175e7a] {
	id_imagen integer [ pk, increment, not null ]
	id_libro integer [ not null ]
	nombre_imagen varchar(150) [ not null ]
	imagen_url varchar(500) [ not null ]
}

Table DetalleCotizacion [headercolor: #175e7a] {
	id_detalle_cotizacion integer [ pk, increment, not null ]
	id_cotizacion integer [ not null ]
	id_libro integer [ not null ]
	cantidad integer [ not null ]
	precio_unitario decimal(10,2) [ not null ]
	subtotal_item decimal(10,2) [ not null ]
}

Table DetalleSolicitud [headercolor: #175e7a] {
	id_detalle_solicitud integer [ pk, increment, not null ]
	id_solicitud integer [ not null ]
	id_libro integer [ not null ]
	cantidad_estimada integer [ not null ]
	acabado_portada varchar(50)
	tipo_papel varchar(50)
}

Ref Posee {
	Usuario.id_rol > Rol.id_rol [ delete: no action, update: no action ]
}

Ref "Se asocia a" {
	Usuario.id_usuario < Cliente.id_usuario [ delete: no action, update: no action ]
}

Ref Realiza {
	Cliente.id_cliente < Solicitud.id_cliente [ delete: no action, update: no action ]
}

Ref Genera {
	Solicitud.id_solicitud < Cotizacion.id_solicitud [ delete: no action, update: no action ]
}

Ref Procesa {
	Usuario.id_usuario < Orden.id_usuario [ delete: no action, update: no action ]
}

Ref "Se convierte en" {
	Cotizacion.id_cotizacion < Orden.id_cotizacion [ delete: no action, update: no action ]
}

Ref Desglosa {
	Cotizacion.id_cotizacion < DetalleCotizacion.id_cotizacion [ delete: no action, update: no action ]
}

Ref Contiene {
	Solicitud.id_solicitud < DetalleSolicitud.id_solicitud [ delete: no action, update: no action ]
}

Ref Incluye {
	Orden.id_orden < DetalleOrden.id_orden [ delete: no action, update: no action ]
}

Ref Pertenece {
	Categoria.id_categoria < Libro.id_categoria [ delete: no action, update: no action ]
}

Ref Publica {
	Editorial.id_editorial < Libro.id_editorial [ delete: no action, update: no action ]
}

Ref "Se presenta en" {
	Formato.id_formato < Libro.id_formato [ delete: no action, update: no action ]
}

Ref "Se solicita en" {
	Libro.id_libro < DetalleSolicitud.id_libro [ delete: no action, update: no action ]
}

Ref "Se vende en" {
	Libro.id_libro < DetalleOrden.id_libro [ delete: no action, update: no action ]
}

Ref "Mantiene stock en" {
	Libro.id_libro < Inventario.id_libro [ delete: no action, update: no action ]
}

Ref tiene {
	Libro.id_libro < Imagen.id_libro [ delete: no action, update: no action ]
}

Ref "escrito por" {
	Libro.id_autor > Autor.id_autor [ delete: no action, update: no action ]
}

Ref "Se cotiza en" {
	Libro.id_libro < DetalleCotizacion.id_libro [ delete: no action, update: no action ]
}

Ref Clasifica {
	TipoCliente.id_tipoCliente < Cliente.id_tipoCliente [ delete: no action, update: no action ]
}