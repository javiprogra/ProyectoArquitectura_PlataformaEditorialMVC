# ── Servidor ─────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL / Supabase ────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# ── Autenticación ────────────────────────
# Secreto de al menos 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-de-32-caracteres-minimo
JWT_EXPIRES_IN=8h
