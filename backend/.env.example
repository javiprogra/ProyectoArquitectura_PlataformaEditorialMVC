# ── Servidor ─────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL / Supabase ────────────────
# URL directa (o del pooler en modo sesión). Percent-encode la contraseña si
# contiene caracteres reservados (&, @, :, /, #, ?) → p. ej. & = %26
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
DB_SSL=true
DB_POOL_MAX=10
DB_LOGGING=true

# ── Autenticación ────────────────────────
# Secreto de al menos 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-de-32-caracteres-minimo
JWT_EXPIRES_IN=8h
